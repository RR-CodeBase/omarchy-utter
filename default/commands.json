{
  "version": 3,
  "wakeWords": [
    "omarchy",
    "computer",
    "hey omarchy"
  ],
  "slots": {
    "dir": {
      "l": [
        "left"
      ],
      "r": [
        "right"
      ],
      "u": [
        "up",
        "above",
        "upward",
        "top"
      ],
      "d": [
        "down",
        "below",
        "downward",
        "bottom"
      ]
    },
    "num": {
      "1": [
        "one",
        "won",
        "1"
      ],
      "2": [
        "two",
        "to",
        "too",
        "2"
      ],
      "3": [
        "three",
        "tree",
        "3"
      ],
      "4": [
        "four",
        "for",
        "fore",
        "4"
      ],
      "5": [
        "five",
        "5"
      ],
      "6": [
        "six",
        "sicks",
        "6"
      ],
      "7": [
        "seven",
        "7"
      ],
      "8": [
        "eight",
        "ate",
        "8"
      ],
      "9": [
        "nine",
        "9"
      ],
      "10": [
        "ten",
        "10"
      ]
    }
  },
  "commands": [
    {
      "id": "focus.move",
      "group": "Windows",
      "say": [
        "focus {dir}",
        "go {dir}",
        "move focus {dir}",
        "focus the {dir} window"
      ],
      "run": "hyprctl dispatch 'hl.dsp.focus({ direction = \"{dir}\" })'",
      "label": "Focus {dir}"
    },
    {
      "id": "window.move",
      "group": "Windows",
      "say": [
        "move {dir}",
        "move window {dir}",
        "move this {dir}",
        "push {dir}",
        "throw it {dir}"
      ],
      "run": "hyprctl dispatch 'hl.dsp.window.swap({ direction = \"{dir}\" })'",
      "label": "Move window {dir}"
    },
    {
      "id": "window.close",
      "group": "Windows",
      "say": [
        "close window",
        "close this",
        "close it",
        "kill this",
        "kill window",
        "close the window"
      ],
      "run": "hyprctl dispatch 'hl.dsp.window.close()'",
      "label": "Close window"
    },
    {
      "id": "window.fullscreen",
      "group": "Windows",
      "say": [
        "full screen",
        "fullscreen",
        "make it full screen",
        "maximise",
        "maximize",
        "make this full screen"
      ],
      "run": "hyprctl dispatch 'hl.dsp.window.fullscreen({ mode = \"fullscreen\" })'",
      "label": "Fullscreen"
    },
    {
      "id": "window.float",
      "group": "Windows",
      "say": [
        "float this",
        "float it",
        "toggle floating",
        "unfloat this",
        "float window"
      ],
      "run": "hyprctl dispatch 'hl.dsp.window.float({ action = \"toggle\" })'",
      "label": "Toggle floating"
    },
    {
      "id": "window.split",
      "group": "Windows",
      "say": [
        "split",
        "toggle split",
        "split this",
        "flip the split"
      ],
      "run": "hyprctl dispatch 'hl.dsp.layout(\"togglesplit\")'",
      "label": "Toggle split"
    },
    {
      "id": "window.center",
      "group": "Windows",
      "say": [
        "center this",
        "centre this",
        "center window",
        "centre window"
      ],
      "run": "hyprctl dispatch 'hl.dsp.window.center()'",
      "label": "Center window"
    },
    {
      "id": "window.pin",
      "group": "Windows",
      "say": [
        "pin this",
        "pin it",
        "pin window",
        "unpin this"
      ],
      "run": "hyprctl dispatch 'hl.dsp.window.pin()'",
      "label": "Pin window"
    },
    {
      "id": "workspace.go",
      "group": "Workspaces",
      "say": [
        "workspace {num}",
        "go to workspace {num}",
        "switch to workspace {num}",
        "desktop {num}",
        "take me to workspace {num}",
        "workspace number {num}"
      ],
      "run": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"{num}\" })'",
      "label": "Workspace {num}"
    },
    {
      "id": "workspace.next",
      "group": "Workspaces",
      "say": [
        "next workspace",
        "workspace next",
        "next desktop"
      ],
      "run": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
      "label": "Next workspace"
    },
    {
      "id": "workspace.prev",
      "group": "Workspaces",
      "say": [
        "previous workspace",
        "last workspace",
        "workspace back",
        "previous desktop"
      ],
      "run": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
      "label": "Previous workspace"
    },
    {
      "id": "workspace.former",
      "group": "Workspaces",
      "say": [
        "go back",
        "last one",
        "former workspace",
        "back to the last workspace"
      ],
      "run": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"previous\" })'",
      "label": "Former workspace"
    },
    {
      "id": "workspace.throw",
      "group": "Workspaces",
      "say": [
        "move this to {num}",
        "throw this to {num}",
        "send this to workspace {num}",
        "move to workspace {num}",
        "throw it to {num}",
        "move this window to workspace {num}",
        "move this window to {num}",
        "send this window to workspace {num}",
        "move it to workspace {num}",
        "send it to {num}"
      ],
      "run": "hyprctl dispatch 'hl.dsp.window.move({ workspace = \"{num}\" })'",
      "label": "Move window to workspace {num}"
    },
    {
      "id": "app.launch",
      "group": "Apps",
      "say": [
        "open {appname}",
        "launch {appname}",
        "start {appname}",
        "open up {appname}",
        "bring up {appname}",
        "switch to {appname}"
      ],
      "label": "Open {appname}",
      "internal": "launch",
      "note": "resolved against installed apps; free text never reaches a shell"
    },
    {
      "id": "menu.open",
      "group": "Apps",
      "say": [
        "open menu",
        "show menu",
        "omarchy menu",
        "main menu"
      ],
      "run": "omarchy menu",
      "label": "Omarchy menu"
    },
    {
      "id": "menu.keybindings",
      "group": "Apps",
      "say": [
        "show keybindings",
        "what are my keybindings",
        "keybindings",
        "show shortcuts"
      ],
      "run": "omarchy menu keybindings",
      "label": "Keybindings"
    },
    {
      "id": "clipboard.open",
      "group": "Apps",
      "say": [
        "show clipboard",
        "clipboard history",
        "open clipboard",
        "paste history"
      ],
      "run": "omarchy menu clipboard",
      "label": "Clipboard history"
    },
    {
      "id": "volume.up",
      "group": "Sound",
      "say": [
        "volume up",
        "louder",
        "turn it up",
        "turn the volume up"
      ],
      "run": "omarchy audio output volume raise",
      "label": "Volume up"
    },
    {
      "id": "volume.down",
      "group": "Sound",
      "say": [
        "volume down",
        "quieter",
        "turn it down",
        "turn the volume down"
      ],
      "run": "omarchy audio output volume lower",
      "label": "Volume down"
    },
    {
      "id": "volume.mute",
      "group": "Sound",
      "say": [
        "mute",
        "unmute",
        "mute the sound",
        "silence",
        "mute audio"
      ],
      "run": "omarchy audio output volume mute-toggle",
      "label": "Mute audio"
    },
    {
      "id": "mic.mute",
      "group": "Sound",
      "say": [
        "mute the microphone",
        "mute mic",
        "unmute the microphone",
        "unmute mic",
        "mute my mic"
      ],
      "run": "omarchy audio input mute",
      "label": "Mute microphone"
    },
    {
      "id": "brightness.up",
      "group": "Display",
      "say": [
        "brighter",
        "brightness up",
        "turn up the brightness"
      ],
      "run": "omarchy brightness display +10%",
      "label": "Brightness up"
    },
    {
      "id": "brightness.down",
      "group": "Display",
      "say": [
        "dimmer",
        "darker",
        "brightness down",
        "turn down the brightness"
      ],
      "run": "omarchy brightness display 10%-",
      "label": "Brightness down"
    },
    {
      "id": "nightlight.toggle",
      "group": "Display",
      "say": [
        "night light",
        "toggle night light",
        "warm the screen",
        "blue light filter"
      ],
      "run": "omarchy toggle nightlight",
      "label": "Night light"
