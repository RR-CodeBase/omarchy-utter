      "run": "omarchy toggle notification silencing",
      "label": "Do not disturb"
    },
    {
      "id": "idle.toggle",
      "group": "Focus",
      "say": [
        "stay awake",
        "keep awake",
        "caffeine",
        "allow idle",
        "stop staying awake"
      ],
      "run": "omarchy toggle idle",
      "label": "Stay awake"
    },
    {
      "id": "bar.toggle",
      "group": "Focus",
      "say": [
        "hide the bar",
        "show the bar",
        "toggle the bar"
      ],
      "run": "omarchy toggle bar",
      "label": "Toggle bar"
    },
    {
      "id": "capture.region",
      "group": "Capture",
      "say": [
        "screenshot",
        "take a screenshot",
        "capture region",
        "grab a screenshot"
      ],
      "run": "omarchy capture screenshot region",
      "label": "Screenshot a region"
    },
    {
      "id": "capture.screen",
      "group": "Capture",
      "say": [
        "screenshot the screen",
        "capture the whole screen",
        "full screenshot",
        "screenshot everything"
      ],
      "run": "omarchy capture screenshot fullscreen",
      "label": "Screenshot the screen"
