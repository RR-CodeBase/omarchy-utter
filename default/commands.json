      "id": "session.lock",
      "group": "Session",
      "confirm": false,
      "say": [
        "lock the screen",
        "lock screen",
        "lock it",
        "lock my computer"
      ],
      "run": "omarchy system lock",
      "label": "Lock screen"
    },
    {
      "id": "session.sleep",
      "group": "Session",
      "confirm": true,
      "say": [
        "go to sleep",
        "suspend",
        "sleep the computer"
      ],
      "run": "omarchy system sleep lock",
      "label": "Sleep"
    },
    {
      "id": "session.reboot",
      "group": "Session",
      "confirm": true,
      "say": [
        "reboot",
        "restart the computer",
        "reboot the computer"
      ],
      "run": "omarchy system reboot",
      "label": "Reboot"
    },
    {
      "id": "session.shutdown",
      "group": "Session",
      "confirm": true,
      "say": [
        "shut down",
        "shutdown",
        "power off",
        "turn off the computer"
      ],
      "run": "omarchy system shutdown",
      "label": "Shut down"
